# Costia — Configuración de entorno local
# Copia este archivo como .env (o define estas variables en tu servidor Apache/PHP)

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=costia_db
DB_USER=root
DB_PASS=

# Ruta opcional de PHP para las pruebas automatizadas Playwright (Linux/Mac: php | XAMPP Windows: "C:\xampp\php\php.exe")
PHP_BIN=php

# Asesor IA opcional (Ollama local en http://127.0.0.1:11434 con el modelo qwen2.5:3b)
# Si Ollama no está ejecutándose, Costia cambia automáticamente al motor determinista integrado.
